datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER") // "ADMIN" | "CUSTOMER"
  phone        String?
  address      String?
  city         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders         Order[]
  fantasyTeams   FantasyTeam[]
  fantasyRewards FantasyReward[]
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  slug          String   @unique
  subtitle      String
  price         Int      // In BDT (e.g. 1150)
  originalPrice Int?     // In BDT (e.g. 1450)
  league        String   // "Premier League" | "La Liga" | "Serie A" | "Bundesliga" | "Saudi Pro League" | "International" | "Retro"
  club          String
  dominantColor String   @default("#0d0f14")
  accentColor   String   @default("#f59e0b")
  image         String
  weightGsm     Int      @default(240)
  fabric        String   @default("Aero-Fit Engineered Knit")
  badgeType     String   @default("3D Heat-pressed liquid silicone crest")
  sleeve        String   @default("Half sleeve") // "Half sleeve" | "Full sleeve"
  kitType       String   @default("Home") // "Home" | "Away" | "Third" | "Retro"
  story         String
  stockS        Int      @default(5)
  stockM        Int      @default(8)
  stockL        Int      @default(10)
  stockXL       Int      @default(6)
  stockXXL      Int      @default(3)
  isFeatured    Boolean  @default(false)
  inStock       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  reviews       Review[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userName  String
  userCity  String   @default("Dhaka")
  rating    Int      @default(5)
  comment   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id               String   @id @default(cuid())
  orderNumber      String   @unique // e.g. "JV-92841"
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  customerName     String
  phone            String
  email            String?
  address          String
  city             String   @default("Dhaka")
  zone             String   @default("inside_dhaka") // "inside_dhaka" | "outside_dhaka"
  paymentMethod    String   @default("bkash") // "bkash" | "nagad"
  senderNumber     String
  trxId            String
  paymentStatus    String   @default("PENDING_VERIFICATION") // "PENDING_VERIFICATION" | "VERIFIED" | "FAILED"
  orderStatus      String   @default("PENDING") // "PENDING" | "CONFIRMED" | "PRINTING" | "DISPATCHED" | "DELIVERED" | "CANCELLED"
  subtotal         Int
  shippingFee      Int      @default(80)
  customizationFee Int      @default(0)
  discount         Int      @default(0)
  total            Int
  courierPartner   String?  // e.g. "Steadfast Courier" | "Pathao" | "Paperfly"
  consignmentId    String?  // e.g. "CID-982741"
  itemsJson        String   // Serialized array of items with size, customName, customNumber
  adminNote        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model FantasyPlayer {
  id                String         @id @default(cuid())
  name              String
  shortName         String
  club              String
  position          String         // "GK" | "DEF" | "MID" | "FWD"
  price             Float          // e.g. 12.5 in millions
  form              Float          @default(5.0)
  totalPoints       Int            @default(0)
  eventPoints       Int            @default(0)
  selectedByPercent Float          @default(10.0)
  goals             Int            @default(0)
  assists           Int            @default(0)
  cleanSheets       Int            @default(0)
  yellowCards       Int            @default(0)
  redCards          Int            @default(0)
  saves             Int            @default(0)
  image             String?
  jerseyColor       String         @default("#f59e0b")
  status            String         @default("AVAILABLE") // "AVAILABLE" | "INJURED" | "SUSPENDED"
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  picks             FantasyPick[]
}

model Gameweek {
  id         String   @id @default(cuid())
  number     Int      @unique
  name       String   // e.g. "Matchday 1"
  deadline   DateTime
  isCurrent  Boolean  @default(false)
  isFinished Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model FantasyTeam {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String            // e.g. "Dhaka Galacticos"
  totalPoints   Int               @default(0)
  eventPoints   Int               @default(0)
  overallRank   Int               @default(1)
  bank          Float             @default(0.0) // Remaining budget in millions
  freeTransfers Int               @default(1)
  chipsUsed     String            @default("[]") // JSON string e.g. '["wildcard"]'
  activeChip    String?           // "triple_captain" | "bench_boost" | "free_hit" | "wildcard"
  formation     String            @default("4-3-3")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  picks         FantasyPick[]
  transfers     FantasyTransfer[]
}

model FantasyPick {
  id            String        @id @default(cuid())
  teamId        String
  team          FantasyTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId      String
  player        FantasyPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  positionOrder Int           // 1 to 11 for Starting XI, 12 to 15 for Substitutes bench
  isCaptain     Boolean       @default(false)
  isViceCaptain Boolean       @default(false)
  multiplier    Int           @default(1) // 2 for Captain, 3 for Triple Captain
}

model FantasyLeague {
  id        String                @id @default(cuid())
  name      String
  code      String                @unique // e.g. "JV-9284"
  type      String                @default("CLASSIC") // "GLOBAL" | "PRIVATE"
  adminId   String?
  createdAt DateTime              @default(now())
  members   FantasyLeagueMember[]
}

model FantasyLeagueMember {
  id          String        @id @default(cuid())
  leagueId    String
  league      FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId      String
  teamName    String
  managerName String
  rank        Int           @default(1)
  totalPoints Int           @default(0)
  createdAt   DateTime      @default(now())
}

model FantasyTransfer {
  id          String      @id @default(cuid())
  teamId      String
  team        FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerInId  String
  playerOutId String
  cost        Int         @default(0) // Point deduction penalty (e.g. 4 pts for extra transfer)
  createdAt   DateTime    @default(now())
}

model FantasyReward {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String   // e.g. "Gameweek 1 Champion (৳500 Jersey Voucher)"
  code           String   @unique // e.g. "FANTASY-GW1-9824"
  discountAmount Int      // e.g. 500
  isClaimed      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

